org.apache.streampipes.processors.enricher.jvm.processor.assethierarchy.title=Asset Hierarchy Enrichment
org.apache.streampipes.processors.enricher.jvm.processor.assethierarchy.description=Enriches every event with Maximo asset hierarchy metadata (location, route, site, MQTT topic)

asset-location.title=Asset Location (LOCATION)
asset-location.description=The Maximo LOCATION code of this datapoint (e.g. B-41661)

asset-description.title=Asset Description
asset-description.description=The Maximo DESCRIPTION of this asset location

asset-route.title=Asset Route
asset-route.description=The Maximo ROUTE string for this location (e.g. B; B-4; B-41; B-416; B-4166; B-41661). Used to derive the MQTT topic.

asset-site-id.title=Site ID (SITEID)
asset-site-id.description=The Maximo SITEID

asset-org-id.title=Organisation ID (ORGID)
asset-org-id.description=The Maximo ORGID
